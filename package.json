{
  "name": "dw256.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./css/main.css -o ./css/main2.css --minify",
    "build:projects": "node generate-projects.js",
    "build": "npm run build:projects && npm run build:css",
    "validate:projects": "node generate-projects.js --validate",
    "check:projects": "node generate-projects.js --check",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "preview": "node script/serve.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "dompurify": "3.4.16",
    "marked": "18.0.6"
  }
}
